{
  "name": "cms",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run with-env -- next dev --port 3006",
    "build": "npm run with-env -- next build",
    "start": "next start --port 3006",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "payload": "npm run with-env -- payload",
    "generate:types": "npm run with-env -- payload generate:types",
    "generate:importmap": "npm run with-env -- payload generate:importmap",
    "migrate": "npm run with-env -- payload migrate",
    "migrate:create": "npm run with-env -- payload migrate:create",
    "migrate:status": "npm run with-env -- payload migrate:status",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@repo/constants": "*",
    "@repo/env": "*",
    "drizzle-kit": "^0.31.10",
    "graphql": "16.14.2",
    "next": "16.2.6",
    "payload": "3.88.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^22.13.10",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.4",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.22.0",
    "typescript": "5.8.2"
  }
}
