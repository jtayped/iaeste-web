{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^check-types"]
    },
    "@repo/api#test": {
      "dependsOn": ["^check-types", "@repo/db#test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "API_PORT",
    "CORS_ALLOWED_ORIGINS",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "SHEETS_PROJECT_ID",
    "SHEETS_PRIVATE_KEY",
    "SHEETS_CLIENT_EMAIL",
    "SHEETS_SPREADSHEET_ID",
    "SHEETS_RANGE",
    "RESEND_API_KEY",
    "CONTACT_FORM_FROM",
    "CONTACT_FORM_TO",
    "REGISTRATION_EMAIL_FROM",
    "INSCRIPCIONS_PUBLIC_ORIGIN",
    "ADMIN_PUBLIC_ORIGIN",
    "API_INTERNAL_URL",
    "WEB_PUBLIC_ORIGIN",
    "WEB_PUSH_VAPID_PUBLIC_KEY",
    "WEB_PUSH_VAPID_PRIVATE_KEY",
    "WEB_PUSH_SUBJECT",
    "CMS_DATABASE_URL",
    "CMS_PAYLOAD_SECRET",
    "CMS_PUBLIC_ORIGIN",
    "CMS_MEDIA_DIR",
    "CMS_EMAIL_FROM",
    "CMS_PREVIEW_SECRET",
    "CMS_INTERNAL_URL",
    "WEB_REVALIDATE_URL",
    "WEB_REVALIDATE_SECRET",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_INSCRIPCIONS_STATE",
    "NEXT_PUBLIC_WHATSAPP_INVITE"
  ],
  "globalPassThroughEnv": ["NODE_ENV", "CI", "PORT", "npm_lifecycle_event"]
}
