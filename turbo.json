{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["content/**", "keystatic.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "API_PORT",
    "CORS_ALLOWED_ORIGINS",
    "SHEETS_PROJECT_ID",
    "SHEETS_PRIVATE_KEY",
    "SHEETS_CLIENT_EMAIL",
    "SHEETS_SPREADSHEET_ID",
    "SHEETS_RANGE",
    "RESEND_API_KEY",
    "CONTACT_FORM_FROM",
    "CONTACT_FORM_TO",
    "KEYSTATIC_GITHUB_CLIENT_ID",
    "KEYSTATIC_GITHUB_CLIENT_SECRET",
    "KEYSTATIC_SECRET",
    "REGISTRATION_EMAIL_FROM",
    "INSCRIPCIONS_PUBLIC_ORIGIN",
    "ADMIN_PUBLIC_ORIGIN",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_INSCRIPCIONS_STATE",
    "NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG",
    "NEXT_PUBLIC_WHATSAPP_INVITE"
  ],
  "globalPassThroughEnv": ["NODE_ENV", "CI", "PORT", "npm_lifecycle_event"]
}
