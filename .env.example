# ---------------------------------------------------------------------------
# packages/db
# ---------------------------------------------------------------------------
# PostgreSQL connection strings. TEST_DATABASE_URL's database must be named
# `iaeste_test` (or start with that prefix) — db:reset, db:seed, and the
# repository test suite all refuse to run against anything else.
DATABASE_URL=postgres://user:password@localhost:5432/iaeste_dev
TEST_DATABASE_URL=postgres://user:password@localhost:5432/iaeste_test

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
# Shared with packages/db above: apps/api's registration repository (IA-12)
# reads DATABASE_URL directly via @repo/db, and its own test suite needs
# TEST_DATABASE_URL to run its Postgres-backed repository tests.
DATABASE_URL=postgres://user:password@localhost:5432/iaeste_dev
TEST_DATABASE_URL=postgres://user:password@localhost:5432/iaeste_test
API_PORT=3004
CORS_ALLOWED_ORIGINS=http://localhost:3003

# Google service account with write access to the registrations spreadsheet.
SHEETS_PROJECT_ID=
SHEETS_PRIVATE_KEY=
SHEETS_CLIENT_EMAIL=
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=inscripcions!A:H

# Resend, used for every registration-related email (verification,
# pending-review, acceptance, rejection) — apps/api's own key/from address,
# separate from apps/web's RESEND_API_KEY/CONTACT_FORM_FROM below.
RESEND_API_KEY=
REGISTRATION_EMAIL_FROM=noreply@iaestelleida.cat
# Public origin of apps/inscripcions — used to build the email-verification
# link (`${origin}/verificar?token=...`). Not the same as
# NEXT_PUBLIC_API_URL below, which points the other way (frontend -> API).
INSCRIPCIONS_PUBLIC_ORIGIN=http://localhost:3003
# Placeholder origin for the first-login link in the acceptance email. There
# is no real admin app or magic-link auth yet (IA-30/IA-31 build that) — this
# just needs to point somewhere sane until then.
ADMIN_PUBLIC_ORIGIN=http://localhost:3005

# ---------------------------------------------------------------------------
# apps/inscripcions  (validated by @repo/env/inscripcions)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3004
# `on` while registrations are open, `off` otherwise. Any other value fails
# validation at startup rather than silently reading as closed.
NEXT_PUBLIC_INSCRIPCIONS_STATE=on
NEXT_PUBLIC_WHATSAPP_INVITE=https://chat.whatsapp.com/example

# ---------------------------------------------------------------------------
# apps/web  (validated by @repo/env/web/client and @repo/env/web/server)
# ---------------------------------------------------------------------------
# Shared with apps/inscripcions above: the marketing site also branches on
# whether registrations are open.
NEXT_PUBLIC_INSCRIPCIONS_STATE=on
RESEND_API_KEY=
CONTACT_FORM_FROM=noreply@iaestelleida.cat
CONTACT_FORM_TO=iaeste.lleida@gmail.com

# Keystatic uses local file storage without these values during development.
# The GitHub App setup fills all four for the deployed admin UI.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
