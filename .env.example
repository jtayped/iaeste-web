# ---------------------------------------------------------------------------
# packages/db
# ---------------------------------------------------------------------------
# PostgreSQL connection strings. TEST_DATABASE_URL's database must be named
# `iaeste_test` (or start with that prefix) — db:reset, db:seed, and the
# repository test suite all refuse to run against anything else.
DATABASE_URL=postgres://user:password@localhost:5432/iaeste_dev
TEST_DATABASE_URL=postgres://user:password@localhost:5432/iaeste_test

# ---------------------------------------------------------------------------
# apps/api
# ---------------------------------------------------------------------------
# Shared with packages/db above: apps/api's registration repository (IA-12)
# reads DATABASE_URL directly via @repo/db, and its own test suite needs
# TEST_DATABASE_URL to run its Postgres-backed repository tests.
DATABASE_URL=postgres://user:password@localhost:5432/iaeste_dev
TEST_DATABASE_URL=postgres://user:password@localhost:5432/iaeste_test
API_PORT=3004
CORS_ALLOWED_ORIGINS=http://localhost:3003

# Better Auth (IA-30), mounted at /api/auth/* in this same API — see
# packages/auth. BETTER_AUTH_SECRET signs auth data; generate a real one for
# any deployed environment with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3005
# Standard Node/Turbo variable (see turbo.json's globalPassThroughEnv), read
# directly by apps/api (not through @repo/env) only to decide whether
# Better Auth's session cookie may relax `Secure` for local development. Leave
# unset locally; every real deployment must set it to "production".
NODE_ENV=development

# Google service account with write access to the registrations spreadsheet.
SHEETS_PROJECT_ID=
SHEETS_PRIVATE_KEY=
SHEETS_CLIENT_EMAIL=
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE=inscripcions!A:H

# Resend, used for every registration-related email (verification,
# pending-review, acceptance, rejection) — apps/api's own key/from address,
# separate from apps/web's RESEND_API_KEY/CONTACT_FORM_FROM below.
RESEND_API_KEY=
REGISTRATION_EMAIL_FROM=noreply@iaestelleida.cat
# Public origin of apps/inscripcions — used to build the email-verification
# link (`${origin}/verificar?token=...`). Not the same as
# NEXT_PUBLIC_API_URL below, which points the other way (frontend -> API).
INSCRIPCIONS_PUBLIC_ORIGIN=http://localhost:3003
# Browser-visible origin for first-login and Better Auth links. IA-31 adds
# the `/api/auth/*` rewrite to apps/api; IA-50 builds the admin app itself.
# Keep this origin in BETTER_AUTH_TRUSTED_ORIGINS too.
ADMIN_PUBLIC_ORIGIN=http://localhost:3005

# Web-push (VAPID) for the admin PWA's notifications. Optional: leave all
# three blank and the API runs with push disabled (a no-op notifier).
# Generate a keypair with `npx web-push generate-vapid-keys`. WEB_PUSH_SUBJECT
# is a mailto: or https: URL identifying this sender to the push services.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:iaeste.lleida@gmail.com

# ---------------------------------------------------------------------------
# apps/admin  (validated by @repo/env/admin/server)
# ---------------------------------------------------------------------------
# Where the admin app's same-origin rewrites and server components reach
# the API. Locally this is the dev API port; on Coolify it is the internal
# service address, not the public hostname. The browser never sees this — /api/auth/* and /api/v1/* are Next.js rewrites, so there is no
# NEXT_PUBLIC_ admin API URL.
API_INTERNAL_URL=http://localhost:3004
# Public origin of apps/web. The admin sidebar links its "continguts" item out
# to ${CMS_PUBLIC_ORIGIN}/admin; this value is also reused by apps/cms below.
WEB_PUBLIC_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# apps/cms  (validated by @repo/env/cms/server)
# ---------------------------------------------------------------------------
# Self-hosted Payload CMS for the blog. Its own PostgreSQL database, isolated
# from packages/db — never reuse DATABASE_URL here. Locally, a separate
# database named iaeste_cms_dev.
CMS_DATABASE_URL=postgres://iaeste_cms:password@localhost:5432/iaeste_cms_dev
# Payload cookie/token secret. At least 32 bytes; generate with
# `openssl rand -base64 32`.
CMS_PAYLOAD_SECRET=change-me-to-a-real-32-byte-random-secret
# Public origin of the CMS itself. https://cms.iaestelleida.cat in production.
CMS_PUBLIC_ORIGIN=http://localhost:3006
# Where uploaded files are written. A gitignored dir locally; the Coolify
# persistent volume at /data/media in production.
CMS_MEDIA_DIR=./apps/cms/.data/media
# Sender for account and password-reset email. Reuses RESEND_API_KEY (below)
# but always sends from its own address.
CMS_EMAIL_FROM=noreply@iaestelleida.cat
# Shared secret for the signed draft-preview flow. At least 32 bytes.
CMS_PREVIEW_SECRET=change-me-to-a-real-32-byte-random-secret
# The public site's protected cache-invalidation endpoint and its shared
# secret. The CMS POSTs here (HMAC-signed) after publish/unpublish/delete.
# Secret at least 32 bytes.
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate/blog
WEB_REVALIDATE_SECRET=change-me-to-a-real-32-byte-random-secret
# Public site origin, used to build the preview redirect URL. Same value as in
# the apps/admin section above.
WEB_PUBLIC_ORIGIN=http://localhost:3000
# Reused by the CMS for account email; already set for apps/api and apps/web.
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# apps/inscripcions  (validated by @repo/env/inscripcions)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3004
# `on` while registrations are open, `off` otherwise. Any other value fails
# validation at startup rather than silently reading as closed.
NEXT_PUBLIC_INSCRIPCIONS_STATE=on
NEXT_PUBLIC_WHATSAPP_INVITE=https://chat.whatsapp.com/example

# ---------------------------------------------------------------------------
# apps/web  (validated by @repo/env/web/client and @repo/env/web/server)
# ---------------------------------------------------------------------------
# Shared with apps/inscripcions above: the marketing site also branches on
# whether registrations are open.
NEXT_PUBLIC_INSCRIPCIONS_STATE=on
RESEND_API_KEY=
CONTACT_FORM_FROM=noreply@iaestelleida.cat
CONTACT_FORM_TO=iaeste.lleida@gmail.com

# Blog backend during the Payload migration: `keystatic` (default, and the
# rollback target) or `payload`. Server-side origin of apps/cms for the narrow
# public blog API, plus the two shared secrets for preview and cache
# invalidation (same values as the apps/cms section above; leave blank until
# the CMS is live).
BLOG_SOURCE=keystatic
CMS_INTERNAL_URL=http://localhost:3006
CMS_PREVIEW_SECRET=change-me-to-a-real-32-byte-random-secret
WEB_REVALIDATE_SECRET=change-me-to-a-real-32-byte-random-secret

# Keystatic uses local file storage without these values during development.
# The GitHub App setup fills all four for the deployed admin UI.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
